---
const stats = [
	{ value: '140+', label: 'Launches shipped' },
	{ value: '$52M', label: 'Client revenue influenced' },
	{ value: '9 yrs', label: 'Building for the web' },
	{ value: '98%', label: 'Client retention' },
];
---

<section class="stats">
	<div class="container grid">
		{stats.map((s, i) => (
			<div class="stat reveal" style={`transition-delay: ${i * 0.08}s`}>
				<strong>{s.value}</strong>
				<span>{s.label}</span>
			</div>
		))}
	</div>
</section>

<style>
	.stats { padding: 90px 0; }
	.grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-top: 1px solid var(--line);
	}
	.stat {
		padding: 38px 28px 6px;
		border-left: 1px solid var(--line);
	}
	.stat:first-child { border-left: none; padding-left: 0; }
	.stat strong {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 4vw, 3.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.stat span {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	@media (max-width: 820px) {
		.grid { grid-template-columns: repeat(2, 1fr); row-gap: 36px; }
		.stat:nth-child(3) { border-left: none; padding-left: 0; }
	}
</style>
