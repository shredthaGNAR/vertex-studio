---
import artPhone from '../assets/art-phone.svg';
import artDashboard from '../assets/art-dashboard.svg';
import artMesh from '../assets/art-mesh.svg';

const projects = [
	{
		img: artPhone.src,
		alt: 'Mobile e-commerce experience for Northwind',
		client: 'Northwind',
		scope: 'E-commerce rebuild — Headless Shopify',
		metric: '+212% CVR',
		tags: ['Commerce', 'CRO'],
	},
	{
		img: artDashboard.src,
		alt: 'Analytics dashboard for Signalboard',
		client: 'Signalboard',
		scope: 'Marketing site + growth analytics',
		metric: '3× demo bookings',
		tags: ['SaaS', 'SEO'],
	},
	{
		img: artMesh.src,
		alt: 'Brand platform for Atlas Studio',
		client: 'Atlas Studio',
		scope: 'Brand platform + design system',
		metric: '1.1s LCP worldwide',
		tags: ['Brand', 'Performance'],
	},
];
---

<section class="work" id="work">
	<div class="container">
		<div class="head">
			<div>
				<p class="eyebrow reveal">Selected Work</p>
				<h2 class="reveal" style="transition-delay: 0.08s">
					Proof of <span class="serif-accent">work.</span>
				</h2>
			</div>
			<p class="sub reveal" style="transition-delay: 0.14s">
				A slice of recent engagements. Every project ships with instrumentation,
				so the results below aren't vibes — they're dashboards.
			</p>
		</div>
		<div class="grid">
			{projects.map((p, i) => (
				<article class="card reveal" style={`transition-delay: ${i * 0.08}s`}>
					<div class="thumb">
						<img src={p.img} alt={p.alt} loading="lazy" />
						<span class="metric">{p.metric}</span>
					</div>
					<div class="meta">
						<div>
							<h3>{p.client}</h3>
							<p>{p.scope}</p>
						</div>
						<div class="tags">
							{p.tags.map((t) => <span>{t}</span>)}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.work { padding: 120px 0; }
	.head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 40px;
		margin-bottom: 70px;
	}
	.head h2 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); margin-top: 22px; }
	.sub { color: var(--muted); max-width: 380px; font-size: 15.5px; }
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}
	.card {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 20px;
		overflow: hidden;
		transition: transform 0.4s var(--ease), border-color 0.4s;
	}
	.card:hover { transform: translateY(-6px); border-color: rgba(200, 255, 46, 0.25); }
	.thumb { position: relative; overflow: hidden; aspect-ratio: 4 / 3; }
	.thumb img {
		width: 100%; height: 100%;
		object-fit: cover;
		transition: transform 0.7s var(--ease);
	}
	.card:hover .thumb img { transform: scale(1.05); }
	.metric {
		position: absolute;
		bottom: 14px; left: 14px;
		background: rgba(6, 6, 8, 0.8);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(200, 255, 46, 0.3);
		color: var(--lime);
		font-family: var(--font-mono);
		font-size: 12.5px;
		padding: 8px 15px;
		border-radius: 100px;
	}
	.meta { padding: 26px; }
	.meta h3 { font-size: 20px; margin-bottom: 6px; }
	.meta p { color: var(--muted); font-size: 14px; margin-bottom: 18px; }
	.tags { display: flex; gap: 8px; }
	.tags span {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		padding: 6px 13px;
		border: 1px solid var(--line);
		border-radius: 100px;
		color: var(--muted);
	}
	@media (max-width: 920px) {
		.grid { grid-template-columns: 1fr; }
		.head { flex-direction: column; align-items: flex-start; }
	}
</style>
